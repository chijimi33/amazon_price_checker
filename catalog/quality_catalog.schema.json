{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chijimi33/amazon_price_checker/catalog/quality_catalog.schema.json",
  "title": "PC parts quality catalog",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "settings",
    "profiles",
    "products"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "settings": {
      "type": "object",
      "required": [
        "quality_tier_order",
        "default_quality_gate"
      ],
      "properties": {
        "quality_tier_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "default_quality_gate": {
          "$ref": "#/$defs/qualityGate"
        }
      },
      "additionalProperties": true
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "condition": {
      "type": "object",
      "required": [
        "path",
        "op",
        "value"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "in",
            "not_in",
            "contains",
            "intersects",
            "gt",
            "gte",
            "lt",
            "lte",
            "exists"
          ]
        },
        "value": true,
        "label": {
          "type": "string"
        },
        "weight": {
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "exists"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "evidenceKind": {
      "enum": [
        "manufacturer",
        "independent_review",
        "technical_database",
        "price_com",
        "retailer",
        "user_report"
      ]
    },
    "qualityGate": {
      "type": "object",
      "properties": {
        "allowed_statuses": {
          "type": "array",
          "items": {
            "enum": [
              "research_required",
              "approved",
              "preferred",
              "rejected",
              "discontinued"
            ]
          }
        },
        "minimum_tier": {
          "type": "string"
        },
        "minimum_evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_evidence_kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceKind"
          }
        },
        "max_review_age_days": {
          "type": "integer",
          "minimum": 0
        },
        "forbidden_risk_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "requirements",
        "preferences"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "preferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "quality_gate": {
          "$ref": "#/$defs/qualityGate"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "kind",
        "title",
        "url",
        "checked_at"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/evidenceKind"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "checked_at": {
          "type": "string",
          "format": "date"
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "product": {
      "type": "object",
      "required": [
        "id",
        "category",
        "brand",
        "model",
        "identifiers",
        "specs",
        "quality"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "brand": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "specs": {
          "type": "object",
          "additionalProperties": true
        },
        "quality": {
          "type": "object",
          "required": [
            "status",
            "tier",
            "summary",
            "strengths",
            "weaknesses",
            "risk_flags",
            "reviewed_at",
            "evidence"
          ],
          "properties": {
            "status": {
              "enum": [
                "research_required",
                "approved",
                "preferred",
                "rejected",
                "discontinued"
              ]
            },
            "tier": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "strengths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "weaknesses": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "risk_flags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reviewed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidence"
              }
            }
          },
          "additionalProperties": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
